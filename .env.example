# ---- IA (Google Gemini, camada gratuita) ----
# Crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-aqui
# Modelos tentados em ordem (se o primeiro estourar a cota, usa o próximo).
GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-lite-latest,gemini-flash-latest

# ---- Banco ----
DB_PATH=/home/ubuntu/eqi-eventos/fatos.db

# ---- API ----
PORT=8001
# 127.0.0.1 = só acessível pelo Caddy (HTTPS). Não exponha a porta 8001 direto na internet.
HOST=127.0.0.1
# Senha única de acesso ao site. TROQUE antes de publicar.
APP_SENHA=eqi2026
# Segredo que assina as sessões. Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Duração do login, em horas
SESSAO_HORAS=12
# Origens liberadas no CORS. "*" = qualquer uma. Com Vercel, prefira a URL do site, ex.: https://eqi-eventos.vercel.app
CORS_ORIGINS=*
# Perguntas por minuto por IP
LIMITE_POR_MINUTO=20

# ---- Agendador ----
# Fuso da janela 7h-22h de dias úteis. Use UTC se preferir horário UTC.
TZ_AGENDA=America/Sao_Paulo

# ---- Robô nos grupos de WhatsApp (Evolution API) ----
# Só liga se GRUPOS_WEBHOOK_SEGREDO e GRUPOS_PERMITIDOS estiverem preenchidos.
EVOLUTION_URL=http://localhost:8080
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=
# Webhook da instância (evento MESSAGES_UPSERT): https://SEU_DOMINIO/evolution/webhook/<segredo>
GRUPOS_WEBHOOK_SEGREDO=
# JIDs dos grupos autorizados, separados por vírgula (ex.: 120363019502650977@g.us). Outros grupos são ignorados.
GRUPOS_PERMITIDOS=
# sombra = decide e registra em grupos_log, sem enviar nada. ativo = envia de verdade.
GRUPOS_MODO=sombra
GRUPOS_ESPERA_SEG=20
GRUPOS_MAX_POR_GRUPO_10MIN=6
GRUPOS_MAX_POR_PESSOA_10MIN=3
