# Chave da API da Anthropic (obrigatória para o agente responder)
ANTHROPIC_API_KEY=

# Modelo e esforço de raciocínio (low | medium | high | xhigh | max)
AGENTE_MODELO=claude-opus-5
AGENTE_ESFORCO=medium

# Fonte de dados de eventos corporativos: "brapi" (API externa) ou "mock" (dados fictícios, para dev/teste)
PROVEDOR_EVENTOS=brapi
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api

# Alíquota de IR retido na fonte sobre JCP usada nas simulações.
# Confirme o valor vigente com a área tributária antes de colocar em produção.
ALIQUOTA_IR_JCP=0.15
