# Configuração da Evolution API (o programa que conecta no WhatsApp).
# Copie este arquivo para .env.evolution, na MESMA pasta do evolution-compose.yml, e preencha as duas senhas.
# Gere cada uma com:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# Chave de acesso à Evolution. Esta MESMA chave vai no .env do projeto, em EVOLUTION_APIKEY.
EVOLUTION_APIKEY=

# Senha do banco de dados interno da Evolution. Não é usada em nenhum outro lugar.
PG_SENHA=
