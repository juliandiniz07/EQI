[Unit]
Description=Assistente EQI - coletor de fatos relevantes (agendador)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/eqi-eventos
EnvironmentFile=/home/ubuntu/eqi-eventos/.env
ExecStart=/home/ubuntu/eqi-eventos/.venv/bin/python scheduler.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
